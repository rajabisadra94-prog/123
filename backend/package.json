{
  "name": "factory-backend",
  "version": "1.13.0",
  "scripts": {
    "build": "tsc",
    "db:check": "prisma migrate diff --from-migrations ./prisma/migrations --to-schema-datamodel ./prisma/schema.prisma --shadow-database-url \"$SHADOW_DATABASE_URL\" --exit-code && echo \"OK: migrations match schema\"",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:new": "prisma migrate dev --name",
    "db:seed": "tsx prisma/seed.ts",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "dev": "tsx watch src/app.ts",
    "start": "node dist/app.js",
    "db:seed:market": "tsx prisma/market.seed.run.ts",
    "db:seed:pooyan": "tsx prisma/pooyan.seed.ts",
    "ledger:chart-sync": "tsx scripts/gl-chart-sync.ts",
    "ledger:preflight": "tsx scripts/ledger-preflight.ts",
    "reset:accounting": "tsx scripts/reset-accounting.ts",
    "ledger:diff": "tsx scripts/ledger-diff.ts",
    "ledger:fx-sync": "tsx scripts/gl-fx-sync.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "archiver": "^7.0.1",
    "axios": "^1.7.2",
    "bcrypt": "^5.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.6.0",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.2",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "prisma": "^5.14.0",
    "tsx": "^4.15.1",
    "typescript": "^5.4.5",
    "vitest": "^3.2.7"
  }
}
